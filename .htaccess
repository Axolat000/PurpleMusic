# Bloque l'accès HTTP direct aux fichiers sensibles (base SQLite, configuration).
# N'affecte PAS PHP lui-même (require_once lit le fichier sur disque, pas via HTTP) —
# seules les requêtes web directes sont refusées.
<FilesMatch "\.(db|sqlite|sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
